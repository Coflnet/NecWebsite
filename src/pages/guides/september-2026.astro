---
import Base from '../../layouts/Base.astro';
const headHtml = "<title>September 2026 Hypixel SkyBlock Guides | NotEnoughCoins</title>\n    <meta name=\"description\" content=\"The September 2026 archive with a Kuudra profit guide covering key costs, Infernal chest value, rerolls and when to push to Infernal.\">\n    <link rel=\"canonical\" href=\"https://notenoughcoins.net/guides/september-2026\">\n\n    <meta property=\"og:url\" content=\"https://notenoughcoins.net/guides/september-2026\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"September 2026 Hypixel SkyBlock Guides\">\n    <meta property=\"og:description\" content=\"Browse the September 2026 Kuudra guide: key costs for all five tiers, a worked Infernal chest example and a decision framework for 2026.\">\n    <meta property=\"og:image\" content=\"https://notenoughcoins.net/static/NEC.png\">";
const bodyHtml = "<main>\n      <div class=\"site-shell\">\n        <section class=\"hero\">\n          <span class=\"badge\">Month archive</span>\n          <h1>September 2026 guides</h1>\n          <p class=\"lede\">September turns to combat money-making with a Kuudra guide built on live bazaar prices: what each key costs, how much an Infernal chest pays back and when the fight is worth your time.</p>\n          <div class=\"button-row\">\n            <a class=\"button\" href=\"/guides\">Back to all guides</a>\n            <a class=\"button secondary\" href=\"/guides/august-2026\">Previous month: August 2026</a>\n          </div>\n        </section>\n\n        <section class=\"section\">\n          <div class=\"section-header\">\n            <span class=\"badge success\">Released in September</span>\n            <h2>Kuudra money-making</h2>\n            <p>One guide covers all five Kuudra tiers, the key economics behind each run and how gear, party and chest choices move your coins per hour.</p>\n          </div>\n          <div class=\"archive-grid\">\n            <article class=\"article-card\">\n              <span class=\"article-meta\">2026-09-26 • Money-Making</span>\n              <h3><a href=\"/guides/kuudra-profit-guide-2026\">Kuudra Profit Guide: Tiers, Keys and Chest EV Explained (2026)</a></h3>\n              <p>Key costs for all five tiers, a worked Infernal chest example with live bazaar prices, rerolls, party roles and whether to push to Infernal.</p>\n            </article>\n          </div>\n        </section>\n      </div>\n    </main>";
---

<Base headHtml={headHtml} bodyHtml={bodyHtml} />
