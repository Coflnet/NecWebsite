---
import Base from '../../layouts/Base.astro';
const headHtml = "<title>September 2026 Hypixel SkyBlock Guides | NotEnoughCoins</title>\n    <meta name=\"description\" content=\"The September 2026 archive covering the market effects of 0.27.1 and the September 17 patch, plus a Kuudra profit guide with key costs, Infernal chest value and rerolls.\">\n    <link rel=\"canonical\" href=\"https://notenoughcoins.net/guides/september-2026\">\n\n    <meta property=\"og:url\" content=\"https://notenoughcoins.net/guides/september-2026\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"September 2026 Hypixel SkyBlock Guides\">\n    <meta property=\"og:description\" content=\"Browse the 0.27.1 price guide with dated Bazaar and AH prices, and the Kuudra guide with key costs for all five tiers and a worked Infernal chest example.\">\n    <meta property=\"og:image\" content=\"https://notenoughcoins.net/static/NEC.png\">";
const bodyHtml = "<main>\n      <div class=\"site-shell\">\n        <section class=\"hero\">\n          <span class=\"badge\">Month archive</span>\n          <h1>September 2026 guides</h1>\n          <p class=\"lede\">September covers the market side of 0.27.1 and the September 17 patch, then turns to combat money-making with a Kuudra guide built on live bazaar prices: which prices moved, what each key costs and when the fight is worth your time.</p>\n          <div class=\"button-row\">\n            <a class=\"button\" href=\"/guides\">Back to all guides</a>\n            <a class=\"button secondary\" href=\"/guides/august-2026\">Previous month: August 2026</a>\n          </div>\n        </section>\n\n        <section class=\"section\">\n          <div class=\"section-header\">\n            <span class=\"badge success\">Released in September</span>\n            <h2>0.27.1 and the September 17 patch</h2>\n            <p>A market guide to the Chocolate Factory release and its follow-up patch, with every price dated and every move tied to a changelog entry.</p>\n          </div>\n          <div class=\"archive-grid\">\n            <article class=\"article-card\">\n              <span class=\"article-meta\">2026-09-07 • Market Watch</span>\n              <h3><a href=\"/guides/hypixel-skyblock-0-27-1-price-changes\">Hypixel SkyBlock 0.27.1 Price Changes: What the Patch Did to Bazaar and AH Prices</a></h3>\n              <p>Dated Bazaar and Auction House prices after the Ananke Feather nerf, the Chocobun fusion and the September 17 Golden Dragon Egg patch, with a trading plan.</p>\n            </article>\n          </div>\n        </section>\n\n        <section class=\"section\">\n          <div class=\"section-header\">\n            <h2>Kuudra money-making</h2>\n            <p>One guide covers all five Kuudra tiers, the key economics behind each run and how gear, party and chest choices move your coins per hour.</p>\n          </div>\n          <div class=\"archive-grid\">\n            <article class=\"article-card\">\n              <span class=\"article-meta\">2026-09-26 • Money-Making</span>\n              <h3><a href=\"/guides/kuudra-profit-guide-2026\">Kuudra Profit Guide: Tiers, Keys and Chest EV Explained (2026)</a></h3>\n              <p>Key costs for all five tiers, a worked Infernal chest example with live bazaar prices, rerolls, party roles and whether to push to Infernal.</p>\n            </article>\n          </div>\n        </section>\n      </div>\n    </main>";
---

<Base headHtml={headHtml} bodyHtml={bodyHtml} />
