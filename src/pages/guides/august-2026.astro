---
import Base from '../../layouts/Base.astro';
const headHtml = "<title>August 2026 Hypixel SkyBlock Guides | NotEnoughCoins</title>\n    <meta name=\"description\" content=\"The August 2026 archive covering Torrhus Canyon at launch and after its first live balance patch, including the Helix Sweep meta.\">\n    <link rel=\"canonical\" href=\"https://notenoughcoins.net/guides/august-2026\">\n\n    <meta property=\"og:url\" content=\"https://notenoughcoins.net/guides/august-2026\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"August 2026 Hypixel SkyBlock Guides\">\n    <meta property=\"og:description\" content=\"Browse the 0.27.0 launch guide and the August 11 post-update analysis, with a sourced Sweep progression plan for Helix Trees.\">\n    <meta property=\"og:image\" content=\"https://notenoughcoins.net/static/NEC.png\">";
const bodyHtml = "<main>\n      <div class=\"site-shell\">\n        <section class=\"hero\">\n          <span class=\"badge\">Month archive</span>\n          <h1>August 2026 guides</h1>\n          <p class=\"lede\">August covers both sides of the 0.27.0 release: the Torrhus Canyon and Critter Safari launch, then the August 11 balance pass and the Sweep progression players built around Helix Trees.</p>\n          <div class=\"button-row\">\n            <a class=\"button\" href=\"/guides\">Back to all guides</a>\n            <a class=\"button secondary\" href=\"/guides/july-2026\">Previous month: July 2026</a>\n          </div>\n        </section>\n\n        <section class=\"section\">\n          <div class=\"section-header\">\n            <span class=\"badge success\">Released in August</span>\n            <h2>Torrhus Canyon and Critter Safari</h2>\n            <p>Two guides cover the released islands from launch through their first live patch, including Safari pacing, market lessons and the new Helix Sweep sources.</p>\n          </div>\n          <div class=\"archive-grid\">\n            <article class=\"article-card\">\n              <span class=\"article-meta\">2026-08-04 • Patch Notes</span>\n              <h3><a href=\"/guides/hypixel-skyblock-0-27-0-torrhus-canyon\">Hypixel SkyBlock 0.27.0 Update Guide: Torrhus Canyon &amp; Critter Safari</a></h3>\n              <p>The two released islands, the Foraging overhaul, Critter Safari's Hunting loop and the launch-week market watch.</p>\n            </article>\n            <article class=\"article-card\">\n              <span class=\"article-meta\">2026-08-11 • Post-Update</span>\n              <h3><a href=\"/guides/post-torrhus-canyon-update\">Torrhus Canyon After One Week: August 11 Patch and Sweep Guide</a></h3>\n              <p>The first live balance patch, launch-week lessons and a sourced upgrade order for maximizing Sweep against Helix Trees.</p>\n            </article>\n          </div>\n        </section>\n      </div>\n    </main>";
---

<Base headHtml={headHtml} bodyHtml={bodyHtml} />
