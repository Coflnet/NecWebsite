const bodyHtml = "<main>\n      <div class=\"site-shell\">\n        <section class=\"hero\">\n          <span class=\"badge\">Month archive</span>\n          <h1>August 2026 guides</h1>\n          <p class=\"lede\">August opens with the 0.27.0 Torrhus Canyon and Critter Safari release, bringing a second Foraging island, the new Hunting progression loop and a fresh launch-week economy to track.</p>\n          <div class=\"button-row\">\n            <a class=\"button\" href=\"/guides\">Back to all guides</a>\n            <a class=\"button secondary\" href=\"/guides/july-2026\">Previous month: July 2026</a>\n          </div>\n        </section>\n\n        <section class=\"section\">\n          <div class=\"section-header\">\n            <span class=\"badge success\">Released in August</span>\n            <h2>Torrhus Canyon and Critter Safari</h2>\n            <p>The August archive starts with practical coverage of the released 0.27.0 islands, Foraging changes, Attribute-driven Safari milestones and launch-week market considerations.</p>\n          </div>\n          <div class=\"archive-grid\">\n            <article class=\"article-card\">\n              <span class=\"article-meta\">2026-08-04 • Patch Notes</span>\n              <h3><a href=\"/guides/hypixel-skyblock-0-27-0-torrhus-canyon\">Hypixel SkyBlock 0.27.0 Update Guide: Torrhus Canyon &amp; Critter Safari</a></h3>\n              <p>The two released islands, the Foraging overhaul, Critter Safari's Hunting loop and the launch-week market watch.</p>\n            </article>\n          </div>\n        </section>\n      </div>\n    </main>";
---

<Base headHtml={headHtml} bodyHtml={bodyHtml} />
